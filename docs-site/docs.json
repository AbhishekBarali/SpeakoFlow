            ]
          },
          {
            "group": "Settings",
            "pages": ["settings/general", "settings/debug", "settings/cli"]
          },
          {
            "group": "Help",
            "pages": [
              "reference/troubleshooting",
              "reference/privacy",
              "reference/about"
            ]
          }
        ]
      }
    ]
  }
}

